      "choices": [
        { "index": 0, "text": "Guzel, tesekkurler.", "next_node_id": "bye" }
      ]
    },
    {
      "node_id": "end",
      "text": "Pazarlik her zaman yapilir! Tekrar beklerim.",
      "portrait": "merchant",
